{
  "name": "docs-transfer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "esbuild src/app.js --bundle --outfile=www/app.bundle.js --format=iife",
    "build:plugin": "tsc -p src/plugins/nearby-transfer/tsconfig.json",
    "sync": "npm run build:web && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor-mlkit/barcode-scanning": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.21.0"
  }
}
